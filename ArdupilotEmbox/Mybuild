package ext_project.ardupilot

@App
@AutoCmd
@CxxCmd(name="arducopter", help="TODO")
@BuildDepends(embox.cxx.LibCxx)
@Build(stage=2, script="$(EXTERNAL_MAKE) configure build install")
module arducopter {
	option boolean debug=true
	option boolean scripting=false
	option boolean networking=false
	option string board="sitl"

	source "^BUILD/extbld/^MOD_PATH/install/arducopter.o"

	@NoRuntime depends embox.cxx.LibCxx
	@NoRuntime depends embox.compat.posix.stubs
	@NoRuntime depends embox.compat.posix.unistd.pipe

	@NoRuntime depends embox.driver.i2c_core
	@NoRuntime depends embox.driver.spi.core
	@NoRuntime depends embox.driver.pwm.pwm_dev
}
